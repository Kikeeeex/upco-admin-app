# Supabase del entorno de desarrollo aprobado; no usar claves de servicio en el navegador.
SUPABASE_URL=
# Clave publicable/anon del proyecto de desarrollo; se entrega al navegador bajo RLS.
SUPABASE_PUBLISHABLE_KEY=
# Tenant Entra ID aprobado, en formato UUID. La app falla cerrada si falta.
ENTRA_TENANT_ID=
